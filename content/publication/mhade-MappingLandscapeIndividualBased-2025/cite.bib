 author = {Mhade, Shreeya and Bhosekar, Utkarsh and Hill, Megan D. and Sinclair, Shelly and Agrawal, Snigdha and Guerrini, Jessica and Zou, Luling and Koebcke, Anna and Kummer, Allisandra G. and Ventura, Paulo C. and Del Valle, Sara Y. and Chinazzi, Matteo and Litvinova, Maria and Vespignani, Alessandro and Ajelli, Marco},
